# NFCore produção (Contabo) — MODELO. Copie para /opt/fm/nfcore/.env, chmod 600. NUNCA versionar valores reais.
POSTGRES_PASSWORD=                      # gerada no servidor (openssl rand -base64 32)

# Borda (domínios públicos atrás do Nginx Proxy Manager)
NFCORE_PUBLIC_HOSTNAME=api.nfcore.com.br
NFCORE_ALLOWED_ORIGINS=https://app.nfcore.com.br
NFCORE_TRUSTED_HOSTS=api.nfcore.com.br,nfcore-api
NFCORE_TRUSTED_PROXY_CIDRS=172.18.0.0/16   # sub-rede da proxy-net (conferir: docker network inspect proxy-net)

# Trial público opt-in (/v1/public/trial-plans) — deixe VAZIO para manter a rota desligada
# (comportamento padrão). Só defina se houver decisão explícita de habilitar o trial público:
# origens separadas por vírgula, e CADA UMA precisa também estar em NFCORE_ALLOWED_ORIGINS
# (o runtime bloqueia a subida com RuntimeConfigurationError se não estiver, em ambiente de
# produção). Habilitar exige também e-mail de ativação configurado (abaixo) e Postgres
# (já padrão nesta composição); sem isso o runtime também recusa subir com o trial ligado.
NFCORE_PUBLIC_TRIAL_ALLOWED_ORIGINS=

# E-mail de ativação (provedor da FM; valores reais só no servidor)
NFCORE_ACTIVATION_EMAIL_PROVIDER=
NFCORE_ACTIVATION_EMAIL_SENDER=
NFCORE_ACTIVATION_EMAIL_API_KEY=
NFCORE_ACTIVATION_BASE_URL=https://app.nfcore.com.br
