# Estrutura esperada do /opt/fm/nfcore/.env.worker (chmod 600; NUNCA versionar valores).
# A credencial de serviço NÃO fica neste arquivo: montar identidade host
# explicitamente no overlay e conservar UID 10001, modo 0600 no host.
# A variável NFCORE_WORKER_GSM_CREDENTIAL_FILE é fixada no compose.
NFCORE_WORKER_GSM_MODE=
NFCORE_GSM_PROJECT_ID=
NFCORE_GSM_ALLOWED_PROJECTS=
NFCORE_GSM_PROJECT_NUMBER=
NFCORE_GSM_API_SERVICE_ACCOUNT=
NFCORE_GSM_WORKER_SERVICE_ACCOUNT=
NFCORE_WORKER_GSM_TENANT_ID=
NFCORE_WORKER_GSM_UNIT_ID=
NFCORE_WORKER_GSM_SIGNING_REFERENCE=
NFCORE_WORKER_GSM_SIGNING_VERSION=
NFCORE_WORKER_GSM_PROVIDER_ID=
NFCORE_WORKER_GSM_RESOURCE=
NFCORE_WORKER_GSM_CLOUD_VERSION=
NFCORE_WORKER_GSM_HOST_NAMESPACE=
NFCORE_WORKER_GSM_DESTINATION_ID=
NFCORE_WORKER_GSM_KEY_ID=
NFCORE_WORKER_GSM_KEY_CREATED_AT=
NFCORE_WORKER_GSM_KEY_NOT_AFTER=
